<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<style>
  @font-face {
    font-family: 'Pretendard';
    src: local('Noto Sans KR');
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{width:1000px;height:1250px}
  body{
    font-family:'Pretendard','Noto Sans KR',-apple-system,sans-serif;
    background:linear-gradient(160deg,#fdf3e7 0%,#fbe6d3 55%,#f8dcc4 100%);
    position:relative;
    overflow:hidden;
  }
  .blob{
    position:absolute;border-radius:50%;
    background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.55), rgba(255,255,255,0) 70%);
  }
  .blob.b1{width:520px;height:520px;top:-160px;right:-140px}
  .blob.b2{width:420px;height:420px;bottom:-180px;left:-140px;background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.35), rgba(255,255,255,0) 70%)}

  .frame{position:relative;z-index:2;width:100%;height:100%;padding:64px 60px;display:flex;flex-direction:column}

  .top-row{display:flex;align-items:center;justify-content:space-between;flex:0 0 auto}
  .middle{flex:1;display:flex;flex-direction:column;justify-content:center}
  .badge{
    display:inline-flex;align-items:center;gap:8px;
    background:#e8622f;color:#fff;font-weight:800;font-size:26px;
    padding:14px 26px;border-radius:999px;letter-spacing:-.01em;
    box-shadow:0 8px 20px rgba(232,98,47,.35);
  }
  .rank{font-size:56px;font-weight:900;color:#e8622f;letter-spacing:-.02em}

  .headline{
    font-size:{{ headline_size|default(64) }}px;
    font-weight:800;
    line-height:1.42;
    color:#241c15;
    letter-spacing:-.02em;
    word-break:keep-all;
  }
  .headline .hl{color:#e8622f}

  .desc{
    margin-top:36px;
    font-size:28px;
    line-height:1.7;
    color:#6b5d4f;
    font-weight:500;
    word-break:keep-all;
  }

  .footer{
    margin-top:auto;
    display:flex;align-items:center;justify-content:space-between;
    border-top:2px solid rgba(36,28,21,.12);
    padding-top:28px;
  }
  .brand{font-size:26px;font-weight:800;color:#241c15}
  .brand span{color:#e8622f}
  .date{font-size:24px;color:#8a7a68;font-weight:600}
</style>
</head>
<body>
  <div class="blob b1"></div>
  <div class="blob b2"></div>
  <div class="frame">
    <div class="top-row">
      <div class="badge">오늘의 AI 소식</div>
      <div class="rank">{{ rank }}위</div>
    </div>
    <div class="middle">
      <div class="headline">{{ headline|safe }}</div>
      {% if desc %}<div class="desc">{{ desc }}</div>{% endif %}
    </div>
    <div class="footer">
      <div class="brand">ai<span>뉴스</span></div>
      <div class="date">{{ date_kr }}</div>
    </div>
  </div>
</body>
</html>
